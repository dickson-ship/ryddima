rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin() {
      return signedIn() && userProfile().data.role == 'admin';
    }
    function isTeacher() {
      return signedIn() && userProfile().data.role == 'teacher';
    }
    function isParent() {
      return signedIn() && userProfile().data.role == 'parent';
    }
    function isLinkedParent(studentId) {
      return isParent() && get(/databases/$(database)/documents/students/$(studentId)).data.parentUid == request.auth.uid;
    }
    function teacherOwnsStudentClass(studentId) {
      return isTeacher()
        && get(/databases/$(database)/documents/students/$(studentId)).data.className == userProfile().data.className;
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.role == 'parent';
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if signedIn() && (
        isAdmin() || (request.auth.uid == userId && request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin() || (isParent() && resource.data.parentUid == request.auth.uid) || (isTeacher() && resource.data.className == userProfile().data.className);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (teacherOwnsStudentClass(studentId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats', 'updatedAt'])
        && request.resource.data.stats.diff(resource.data.stats).affectedKeys().hasOnly(['attendance']));
    }

    match /parentStudentLinks/{linkId} {
      allow read: if isAdmin() || (signedIn() && resource.data.parentUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /attendance/{studentId}/records/{recordId} {
      allow read: if isAdmin() || isLinkedParent(studentId) || teacherOwnsStudentClass(studentId);
      allow create, update: if isAdmin() || teacherOwnsStudentClass(studentId);
      allow delete: if isAdmin();
    }

    match /results/{studentId}/subjects/{subjectId} {
      allow read: if isAdmin() || isLinkedParent(studentId) || teacherOwnsStudentClass(studentId);
      allow create, update: if isAdmin() || teacherOwnsStudentClass(studentId);
      allow delete: if isAdmin();
    }

    // Deny access to every collection not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
